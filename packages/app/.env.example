# Cloud sync is optional. Copy this file to .env.local and fill in your Firebase project's
# config (Firebase console -> Project settings -> General -> "Your apps" -> SDK setup and
# configuration -> Config). These values are not secret — they identify your project to the
# client SDK; actual access control is enforced by Firestore Security Rules (see the deploy
# notes for the rules to paste in).
#
# Leave this file as .env.example (don't fill in real values here) and put your real values
# in .env.local instead — that file is gitignored.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
